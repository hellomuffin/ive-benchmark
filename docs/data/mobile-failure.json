  "dialogue": [
    {
      "tick": 10,
      "speaker": "assistant",
      "text": "Select Never so TripSnap can never access your location.",
      "audio": "assets/media/voice/7e041f65f37ac5a089e4.mp3",
      "duration": 4.050958333333333,
      "start": 13.899999999999999
    },
    {
      "tick": 10,
      "speaker": "user",
      "text": "I'd rather it just asks me each time.",
      "audio": "assets/media/voice/b99196b06a550a8c5115.mp3",
      "duration": 2.4509583333333333,
      "start": 18.200958333333332
    },
    {
      "tick": 10,
      "speaker": "assistant",
      "text": "Got it. Now go back to TripSnap settings to disable tracking.",
      "audio": "assets/media/voice/c8b71af9c048edfe237f.mp3",
      "duration": 4.450958333333333,
      "start": 20.901916666666665
    },
    {
      "tick": 14,
      "speaker": "assistant",
      "text": "Tap Settings at the top left, then go to Privacy & Security.",
      "audio": "assets/media/voice/0135e52dc7cddb564c14.mp3",
      "duration": 4.770958333333334,
      "start": 30.802875
    },
    {
      "tick": 16,
      "speaker": "assistant",
      "text": "Tap Tracking.",
      "audio": "assets/media/voice/744904c15834169c5e43.mp3",
      "duration": 1.2509583333333334,
      "start": 38.32383333333333
    },
    {
      "tick": 18,
      "speaker": "user",
      "text": "Looks like that's everything.",
      "audio": "assets/media/voice/2837dfbbc31475149231.mp3",
      "duration": 1.8909583333333333,
      "start": 42.124791666666674
    },
    {
      "tick": 18,
      "speaker": "assistant",
      "text": "Yep, you're all set!",
      "audio": "assets/media/voice/b77118d871745f42984d.mp3",
      "duration": 1.2909583333333334,
      "start": 44.265750000000004
    },
    {
      "tick": 18,
      "speaker": "user",
      "text": "Awesome, thanks.",
      "audio": "assets/media/voice/5a7edcd70836c86b73e8.mp3",
      "duration": 1.4509583333333333,
      "start": 45.80670833333334
    },
    {
      "tick": 18,
      "speaker": "user",
      "text": "That's all I'm going to do here.",
      "audio": "assets/media/voice/b66621abfc4f42493ecb.mp3",
      "duration": 1.9309583333333333,
