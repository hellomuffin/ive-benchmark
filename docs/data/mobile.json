      "duration": 11.730958333333334,
      "start": 27.773833333333332
    },
    {
      "tick": 14,
      "speaker": "assistant",
      "text": "Great, now tap on 'Privacy & Security'.",
      "audio": "assets/media/voice/80358a4ebb8fd479b02f.mp3",
      "duration": 3.4509583333333333,
      "start": 40.204791666666665
    },
    {
      "tick": 16,
      "speaker": "assistant",
      "text": "Now just toggle the switch next to TripSnap to turn off tracking for it.",
      "audio": "assets/media/voice/485d7033c270bacc6381.mp3",
      "duration": 4.6509583333333335,
      "start": 44.35575
    },
    {
      "tick": 17,
      "speaker": "assistant",
      "text": "Oops, you turned off the main tracking setting at the top, which stops all apps from asking. Turn that back on, and then just toggle the switch specifically next to 'TripSnap' in the list below.",
      "audio": "assets/media/voice/a76390d74df6cbb27eec.mp3",
      "duration": 11.010958333333333,
      "start": 49.256708333333336
    },
    {
      "tick": 17,
      "speaker": "user",
      "text": "Ah, you're right. Fixing that now.",
      "audio": "assets/media/voice/1991c6f5b2c61436cee5.mp3",
      "duration": 2.3709583333333333,
      "start": 60.51766666666667
    },
    {
      "tick": 18,
      "speaker": "assistant",
      "text": "Perfect. Now go ahead and turn off the toggle right next to TripSnap in the list.",
