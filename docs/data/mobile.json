      "tick": 8,
      "speaker": "assistant",
      "text": "Great, now tap 'Never' to stop it from accessing your location.",
      "audio": "assets/media/voice/550ac66829e2c1c07f6d.mp3",
      "duration": 4.530958333333333,
      "start": 3.6000000000000005
    },
    {
      "tick": 9,
      "speaker": "assistant",
      "text": "Oops, you selected 'Ask Next Time Or When I Share'. Make sure to tap 'Never' instead so it can't find out where you are.",
