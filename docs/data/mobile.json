      "duration": 8.330958333333333,
      "start": 8.380958333333334
    },
    {
      "tick": 9,
      "speaker": "user",
      "text": "Oh right, my bad.",
      "audio": "assets/media/voice/d32d9a0ac2a2f7e2a9a6.mp3",
      "duration": 1.5709583333333332,
      "start": 16.961916666666667
    },
    {
      "tick": 10,
      "speaker": "assistant",
      "text": "Perfect. Now tap '< TripSnap' at the top left to go back to the app's settings so we can disable tracking and background refresh.",
      "audio": "assets/media/voice/39cdd641e3da06412ea2.mp3",
      "duration": 8.290958333333334,
      "start": 18.782875
    },
    {
      "tick": 12,
      "speaker": "assistant",
      "text": "Awesome. Background App Refresh is off. To turn off tracking, we need to go to the privacy settings. Tap '< Apps' at the top left, then tap '< Settings' to go back to the main menu.",
