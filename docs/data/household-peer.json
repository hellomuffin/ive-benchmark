      "duration": 3.4909583333333334,
      "start": 26.572874999999993
    },
    {
      "tick": 38,
      "speaker": "assistant",
      "text": "Which action was refused, and what exact reason did the house give?",
      "audio": "assets/media/voice/860d934df6c992db660a.mp3",
